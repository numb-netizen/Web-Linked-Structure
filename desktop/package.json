{
  "name": "chugc-study-portal",
  "version": "1.0.0-beta.1",
  "description": "CHUGC Study Portal — the chugc.cc.cd offline study companion for Windows and Linux",
  "author": "CHUGC Study Portal contributors",
  "license": "GPL-3.0-or-later",
  "homepage": "https://chugc.cc.cd/",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "smoke": "electron .",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "42.11.18",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "bd.edu.chugc.studyportal.desktop",
    "productName": "CHUGC Study Portal",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../site",
        "to": "site",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE-GPL-3.0.txt"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "CHUGC-Study-Portal-${version}-windows-${arch}-setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build-resources/icon.png",
      "artifactName": "CHUGC-Study-Portal-${version}-linux-${arch}.${ext}",
      "category": "Education",
      "executableName": "chugc-study-portal"
    }
  }
}
